<!--
  A janela de ajustes: cabeçalho com o mascote, a prévia da banda, os quatro ajustes num cartão e o
  rodapé com o botão Pronto. Mesma composição do app do Mac (docs/ajustes-en.png), com as
  convenções do Windows 11: barra de título do sistema, Mica no 11 e fundo sólido no 10.
-->
<Window x:Class="PainelDeUso.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PainelDeUso"
        Title="{Binding T.Titulo}"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Background="{DynamicResource CorJanela}"
        Foreground="{DynamicResource CorTexto}"
        FontFamily="{DynamicResource FonteTexto}"
        FontSize="14"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal">

  <!-- A largura é a do conteúdo (540, como no Mac); a moldura do sistema fica por fora. -->
  <Grid x:Name="Cliente" Width="540" Background="Transparent">
    <Grid Margin="20,12,20,20">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Cabeçalho -->
      <StackPanel Grid.Row="0" Orientation="Horizontal">
        <Border Background="{DynamicResource CorLaranjaSuave}" BorderBrush="{DynamicResource CorBorda}"
                BorderThickness="{DynamicResource EspessuraBorda}" CornerRadius="12" Padding="8" VerticalAlignment="Center">
          <local:Mascote x:Name="MascoteCabecalho" Tamanho="2" AutomationProperties.Name="{Binding T.NomeMascote}" />
        </Border>
        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="{Binding T.Titulo}" FontSize="16" FontWeight="SemiBold" />
          <TextBlock Text="{Binding T.Subtitulo}" FontSize="13" Margin="0,1,0,0" Foreground="{DynamicResource CorSecundaria}" />
        </StackPanel>
      </StackPanel>

      <!-- Prévia -->
      <local:TextoEspacado Grid.Row="1" Margin="0,16,0,6" Texto="{Binding T.PreviaMaiusculo}" Espacamento="0.6"
                           FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource CorSecundaria}" />
      <Border Grid.Row="2" CornerRadius="8" Padding="12,10" Background="{DynamicResource CorPrevia}"
              BorderBrush="{DynamicResource CorBordaCartao}" BorderThickness="1">
        <Viewbox StretchDirection="DownOnly" Stretch="Uniform" HorizontalAlignment="Left">
          <local:Previa x:Name="PreviaDaBanda" />
        </Viewbox>
      </Border>

      <!-- Ajustes -->
      <Border Grid.Row="3" Margin="0,16,0,0" Style="{StaticResource Cartao}">
        <StackPanel>
          <Grid Margin="14,9">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="RotuloIdioma" Text="{Binding T.Idioma}" VerticalAlignment="Center" />
            <Border Grid.Column="1" Margin="12,0,0,0" Style="{StaticResource TrilhoSegmentos}">
              <local:GrupoSegmentos AutomationProperties.Name="{Binding T.Idioma}"
                                    AutomationProperties.LabeledBy="{Binding ElementName=RotuloIdioma}">
                <RadioButton Style="{StaticResource Segmento}" GroupName="idioma" Content="English"
                             IsChecked="{Binding Idioma, Converter={StaticResource IgualA}, ConverterParameter=en}" />
                <RadioButton Style="{StaticResource Segmento}" GroupName="idioma" Content="Português"
                             IsChecked="{Binding Idioma, Converter={StaticResource IgualA}, ConverterParameter=pt}" />
              </local:GrupoSegmentos>
            </Border>
          </Grid>
          <Rectangle Style="{StaticResource Divisor}" />

          <Grid Margin="14,9">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="RotuloMoeda" Text="{Binding T.Moeda}" VerticalAlignment="Center" />
            <Border Grid.Column="1" Margin="12,0,0,0" Style="{StaticResource TrilhoSegmentos}">
              <local:GrupoSegmentos AutomationProperties.Name="{Binding T.Moeda}"
                                    AutomationProperties.LabeledBy="{Binding ElementName=RotuloMoeda}"
                                    AutomationProperties.HelpText="{Binding T.MoedaNota}">
                <RadioButton Style="{StaticResource Segmento}" GroupName="moeda" Content="US$"
                             AutomationProperties.Name="{Binding T.NomeDolar}"
                             IsChecked="{Binding Moeda, Converter={StaticResource IgualA}, ConverterParameter=USD}" />
                <RadioButton Style="{StaticResource Segmento}" GroupName="moeda" Content="R$"
                             AutomationProperties.Name="{Binding T.NomeReal}"
                             IsChecked="{Binding Moeda, Converter={StaticResource IgualA}, ConverterParameter=BRL}" />
                <RadioButton Style="{StaticResource Segmento}" GroupName="moeda" Content="€"
                             AutomationProperties.Name="{Binding T.NomeEuro}"
                             IsChecked="{Binding Moeda, Converter={StaticResource IgualA}, ConverterParameter=EUR}" />
              </local:GrupoSegmentos>
            </Border>
            <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource Nota}" Text="{Binding T.MoedaNota}" />
          </Grid>
          <Rectangle Style="{StaticResource Divisor}" />

          <Grid Margin="14,9">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="RotuloMascote" Text="{Binding T.Mascote}" VerticalAlignment="Center" />
            <Border Grid.Column="1" Margin="12,0,0,0" Style="{StaticResource TrilhoSegmentos}">
              <local:GrupoSegmentos AutomationProperties.Name="{Binding T.Mascote}"
                                    AutomationProperties.LabeledBy="{Binding ElementName=RotuloMascote}">
                <RadioButton Style="{StaticResource Segmento}" GroupName="mascote" Content="{Binding T.Animado}"
                             IsChecked="{Binding Mascote, Converter={StaticResource IgualA}, ConverterParameter=animado}" />
                <RadioButton Style="{StaticResource Segmento}" GroupName="mascote" Content="{Binding T.Parado}"
                             IsChecked="{Binding Mascote, Converter={StaticResource IgualA}, ConverterParameter=parado}" />
                <RadioButton Style="{StaticResource Segmento}" GroupName="mascote" Content="{Binding T.Oculto}"
                             IsChecked="{Binding Mascote, Converter={StaticResource IgualA}, ConverterParameter=oculto}" />
              </local:GrupoSegmentos>
            </Border>
          </Grid>
          <Rectangle Style="{StaticResource Divisor}" />

          <Grid Margin="14,9">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="RotuloPorModelo" Text="{Binding T.PorModelo}" VerticalAlignment="Center" />
            <local:Interruptor Grid.Column="1" Margin="12,0,0,0" Style="{StaticResource EstiloInterruptor}"
                               IsChecked="{Binding LimitePorModelo}"
                               AutomationProperties.Name="{Binding T.PorModelo}"
                               AutomationProperties.HelpText="{Binding T.PorModeloNota}"
                               AutomationProperties.LabeledBy="{Binding ElementName=RotuloPorModelo}" />
            <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource Nota}" Text="{Binding T.PorModeloNota}" />
          </Grid>
        </StackPanel>
      </Border>

      <!-- Rodapé -->
      <Grid Grid.Row="4" Margin="0,16,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding T.Rodape}" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource CorSecundaria}" />
        <Button Grid.Column="1" x:Name="BotaoPronto" Style="{StaticResource BotaoDestaque}" Content="{Binding T.Pronto}"
                IsDefault="True" Click="Pronto_Click" />
      </Grid>
    </Grid>
  </Grid>
</Window>
